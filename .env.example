# Copy to .env locally. Never commit .env or paste secrets into chat.
ENABLE_TEST_NOTIFICATIONS=false
PORT=5173
TEST_NOTIFICATION_EMAIL=your-test-inbox@example.com
TEST_NOTIFICATION_PHONE=+919876543210

# EmailJS: connect an email service, create a template, then add these IDs.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Twilio: SMS needs an approved sender number or Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=